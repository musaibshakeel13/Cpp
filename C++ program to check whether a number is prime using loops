#include <iostream>
using namespace std;

int main() {
    int num;
    bool prime = true;

    cout << "Enter a number: ";
    cin >> num;

    if (num <= 1) {
        prime = false;
    }
    else {
        for (int i = 2; i < num; i++) {
            if (num % i == 0) {
                prime = false;
                break;
            }
        }
    }

    if (prime)
        cout << num << " is a Prime Number" << endl;
    else
        cout << num << " is not a Prime Number" << endl;

    if (num == 242117) {
        cout << "My Roll number is lucky" << endl;
    }

    return 0;
}
